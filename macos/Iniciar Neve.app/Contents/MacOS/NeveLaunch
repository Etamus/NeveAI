#!/bin/bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")/../../.." && pwd -P)"
if [ ! -f "$HERE/launch.sh" ]; then
    HERE="$(/usr/bin/osascript -e 'POSIX path of (choose folder with prompt "Selecione a pasta macos do projeto Neve")')" || exit 1
fi
if [ ! -f "$HERE/launch.sh" ]; then
    /usr/bin/osascript -e 'display alert "Pasta incorreta" message "Selecione a pasta macos que contem iniciar.command e launch.sh." as critical'
    exit 1
fi
export NEVE_MACOS_NO_TERMINAL=1
exec /bin/bash "$HERE/launch.sh" start
